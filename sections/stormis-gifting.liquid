<style>
  .stormis-gifting-dark {
    padding: 110px 0;
    background-color: #161210;
    border-top: 1px solid #28201B;
    border-bottom: 1px solid #28201B;
    width: 100%;
    box-sizing: border-box;
  }
  @media (max-width: 767px) {
    .stormis-gifting-dark {
      padding: 65px 0;
    }
  }
  .stormis-gifting-dark__container {
    width: 92% !important;
    max-width: 1440px !important;
    margin: 0 auto !important;
  }
  .stormis-gifting-dark__grid {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 70px !important;
    align-items: center !important;
  }
  @media (max-width: 991px) {
    .stormis-gifting-dark__grid {
      grid-template-columns: 1fr !important;
      gap: 40px !important;
    }
  }
  .stormis-gifting-dark__image-wrap {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid #D4AF37;
    box-shadow: 0 20px 50px rgba(0,0,0,0.6);
  }
  .stormis-gifting-dark__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  .stormis-gifting-dark__image-wrap:hover .stormis-gifting-dark__image {
    transform: scale(1.04);
  }
  .stormis-gifting-dark__title {
    font-family: 'Cormorant Garamond', serif !important;
    font-size: 46px !important;
    line-height: 1.15 !important;
    color: #FAF7F2 !important;
    margin-bottom: 20px !important;
    font-weight: 600 !important;
  }
  @media (max-width: 767px) {
    .stormis-gifting-dark__title {
      font-size: 32px !important;
    }
  }
  .stormis-gifting-dark__desc {
    font-size: 16px;
    line-height: 1.75;
    color: #D5CBC0;
    margin-bottom: 30px;
  }
  .stormis-gifting-features-dark {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 34px;
  }
  .stormis-gifting-feat-dark-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    font-weight: 500;
    color: #FAF7F2;
  }
  .stormis-gifting-feat-dark-item svg {
    color: #E5A93C;
    flex-shrink: 0;
  }
</style>

<section class="stormis-gifting-dark">
  <div class="stormis-gifting-dark__container">
    <div class="stormis-gifting-dark__grid">
      <div class="stormis-gifting-dark__image-wrap">
        <img src="{{ 'prod-giftbox-main.jpg' | asset_url }}" alt="Stormi's Godis Luxury Gift Box" class="stormis-gifting-dark__image" loading="lazy" width="600" height="500">
      </div>

      <div class="stormis-gifting-dark__content">
        <div class="stormis-gold-divider" style="justify-content: flex-start;">
          <span>~ THE ART OF GIFTING ~</span>
        </div>
        <h2 class="stormis-gifting-dark__title">Give Something Sweeter</h2>
        <p class="stormis-gifting-dark__desc">
          Whether celebrating milestones, delighting dinner hosts, or curating luxury corporate appreciation, our signature keepsake gift hampers turn sweet treats into unforgettable gestures.
        </p>

        <div class="stormis-gifting-features-dark">
          <div class="stormis-gifting-feat-dark-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Signature rigid boxes with gold foil embossing & satin ribbons</span>
          </div>
          <div class="stormis-gifting-feat-dark-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Complimentary handwritten personalized gift note</span>
          </div>
          <div class="stormis-gifting-feat-dark-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Direct doorstep delivery in protective temperature-safe packaging</span>
          </div>
        </div>

        <a href="/collections/all" class="stormis-gold-btn">
          Shop Gift Boxes
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Stormis Dark Gifting",
  "settings": [],
  "presets": [
    {
      "name": "Stormis Dark Gifting"
    }
  ]
}
{% endschema %}
