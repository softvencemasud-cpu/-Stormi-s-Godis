<style>
  .stormis-ingredients-dark {
    padding: 100px 0;
    background-color: #FFFFFF;
    border-top: 1px solid #E8E1D9;
    border-bottom: 1px solid #E8E1D9;
    width: 100%;
    box-sizing: border-box;
  }
  @media (max-width: 767px) {
    .stormis-ingredients-dark {
      padding: 60px 0;
    }
  }
  .stormis-ingredients-dark__container {
    width: 92% !important;
    max-width: 1440px !important;
    margin: 0 auto !important;
  }
  .stormis-ingredients-dark__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 60px;
    align-items: center;
  }
  @media (max-width: 991px) {
    .stormis-ingredients-dark__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
  .stormis-macro-wrap {
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid #E8E1D9;
    box-shadow: none !important;
  }
  .stormis-macro-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .stormis-ingredients-dark__title {
    font-family: 'Cormorant Garamond', serif !important;
    font-size: 42px !important;
    line-height: 1.15 !important;
    color: #110E0D !important;
    margin-bottom: 18px !important;
    font-weight: 600 !important;
  }
  @media (max-width: 767px) {
    .stormis-ingredients-dark__title {
      font-size: 28px !important;
    }
  }
  .stormis-ing-item {
    display: flex;
    gap: 16px;
    margin-bottom: 20px;
    align-items: flex-start;
  }
  .stormis-ing-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #FAF7F2;
    border: 1px solid #E8E1D9;
    color: #C98D28;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 16px;
  }
  .stormis-ing-title {
    font-size: 16px;
    font-weight: 700;
    color: #110E0D;
    margin-bottom: 4px;
  }
  .stormis-ing-desc {
    font-size: 14px;
    color: #6E6259;
    line-height: 1.6;
    margin: 0;
  }
</style>

<section class="stormis-ingredients-dark">
  <div class="stormis-ingredients-dark__container">
    <div class="stormis-ingredients-dark__grid">
      <!-- Image Display -->
      <div class="stormis-macro-wrap">
        <img src="{{ 'prod-berry-macro.jpg' | asset_url }}" alt="Nordic Berry Texture" class="stormis-macro-img" loading="lazy" width="600" height="450">
      </div>

      <!-- Ingredients Story Content -->
      <div>
        <div class="stormis-gold-divider" style="justify-content: flex-start;">
          <span>~ THE DETAILS MATTER ~</span>
        </div>
        <h2 class="stormis-ingredients-dark__title">
          Wild Nordic Berries & Single-Origin Cocoa
        </h2>

        <div class="stormis-ing-item">
          <div class="stormis-ing-icon">🌿</div>
          <div>
            <div class="stormis-ing-title">Hand-Harvested Wild Berries</div>
            <p class="stormis-ing-desc">Wild lingonberries and cloudberries foraged from pristine northern Swedish forests.</p>
          </div>
        </div>

        <div class="stormis-ing-item">
          <div class="stormis-ing-icon">🍫</div>
          <div>
            <div class="stormis-ing-title">70% Single-Origin Dark Cocoa</div>
            <p class="stormis-ing-desc">Ethically sourced cocoa beans infused with organic cream and 24k edible gold flakes.</p>
          </div>
        </div>

        <div class="stormis-ing-item">
          <div class="stormis-ing-icon">🌱</div>
          <div>
            <div class="stormis-ing-title">Gelatin-Free & Plant-Based Pectin</div>
            <p class="stormis-ing-desc">100% natural fruit pectins and botanical extracts with zero artificial flavorings.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Stormis Light Ingredients",
  "settings": [],
  "presets": [
    {
      "name": "Stormis Light Ingredients"
    }
  ]
}
{% endschema %}
