<style>
  .stormis-about-dark {
    padding: 100px 0;
    background-color: #FFFFFF;
    border-top: 1px solid #E8E1D9;
    border-bottom: 1px solid #E8E1D9;
    width: 100%;
    box-sizing: border-box;
  }
  @media (max-width: 767px) {
    .stormis-about-dark {
      padding: 60px 0;
    }
  }
  .stormis-about-dark__container {
    width: 92% !important;
    max-width: 1440px !important;
    margin: 0 auto !important;
  }
  .stormis-about-dark__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  @media (max-width: 991px) {
    .stormis-about-dark__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
  .stormis-pedestal-wrap {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid #E8E1D9;
    box-shadow: none !important;
  }
  .stormis-pedestal-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .stormis-about-dark__title {
    font-family: 'Cormorant Garamond', serif !important;
    font-size: 42px !important;
    line-height: 1.15 !important;
    color: #110E0D !important;
    margin-bottom: 20px !important;
    font-weight: 600 !important;
  }
  @media (max-width: 767px) {
    .stormis-about-dark__title {
      font-size: 28px !important;
    }
  }
  .stormis-about-dark__p {
    font-size: 15px;
    line-height: 1.8;
    color: #6E6259;
    margin-bottom: 20px;
  }
  .stormis-about-dark__quote {
    border-left: 2px solid #C98D28;
    padding-left: 18px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 19px;
    font-style: italic;
    color: #110E0D;
    margin: 24px 0 30px;
  }
</style>

<section class="stormis-about-dark">
  <div class="stormis-about-dark__container">
    <div class="stormis-about-dark__grid">
      <!-- Pedestal Display Photo -->
      <div class="stormis-pedestal-wrap">
        <img src="{{ 'stormis-brand-story.jpg' | asset_url }}" alt="Stormi’s Godis Pedestal Showcase" class="stormis-pedestal-img" loading="lazy" width="600" height="450">
      </div>

      <!-- Story Copy -->
      <div>
        <div class="stormis-gold-divider" style="justify-content: flex-start;">
          <span>~ ABOUT <span class="stormis-script" style="font-size: 28px;">Stormi’s Godis</span> ~</span>
        </div>
        <h2 class="stormis-about-dark__title">
          Where Swedish Sweet Tradition Meets Modern Luxury
        </h2>
        <p class="stormis-about-dark__p">
          In Sweden, <em>lördagsgodis</em> (Saturday sweets) and the ritual of <em>fika</em> are sacred celebrations of mindful indulgence. Born from a profound passion for artisan confectionery, Stormi’s Godis redefines traditional confectionery into an elevated sensory journey.
        </p>
        <p class="stormis-about-dark__p">
          We kettle-cook in limited small batches using wild hand-harvested Scandinavian lingonberries, cloudberries, real fruit pectins, and single-origin dark chocolate. Gelatin-free, free of artificial dyes, and designed for unforgettable gifting.
        </p>
        <div class="stormis-about-dark__quote">
          “True sweetness is not loud — it is nuanced, elegant, and crafted with reverence for natural Nordic ingredients.”
        </div>
        <a href="/pages/about-us" class="stormis-gold-btn">
          Read Our Full Story
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Stormis Light Story",
  "settings": [],
  "presets": [
    {
      "name": "Stormis Light Story"
    }
  ]
}
{% endschema %}
