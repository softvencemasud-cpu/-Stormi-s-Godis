<style>
  .stormis-gifting-dark {
    padding: 100px 0;
    background-color: #FAF7F2;
    border-top: 1px solid #E8E1D9;
    border-bottom: 1px solid #E8E1D9;
    width: 100%;
    box-sizing: border-box;
  }
  @media (max-width: 767px) {
    .stormis-gifting-dark {
      padding: 60px 0;
    }
  }
  .stormis-gifting-dark__container {
    width: 92% !important;
    max-width: 1440px !important;
    margin: 0 auto !important;
  }
  .stormis-gifting-dark__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  @media (max-width: 991px) {
    .stormis-gifting-dark__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
  .stormis-gifting-img-wrap {
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid #E8E1D9;
    box-shadow: none !important;
  }
  .stormis-gifting-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .stormis-gifting-dark__title {
    font-family: 'Cormorant Garamond', serif !important;
    font-size: 42px !important;
    line-height: 1.15 !important;
    color: #110E0D !important;
    margin-bottom: 18px !important;
    font-weight: 600 !important;
  }
  @media (max-width: 767px) {
    .stormis-gifting-dark__title {
      font-size: 28px !important;
    }
  }
  .stormis-gifting-features {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 24px 0 32px;
  }
  .stormis-gift-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    color: #110E0D;
  }
  .stormis-gift-item span {
    color: #C98D28;
    font-size: 18px;
  }
</style>

<section class="stormis-gifting-dark">
  <div class="stormis-gifting-dark__container">
    <div class="stormis-gifting-dark__grid">
      <!-- Gifting Story -->
      <div>
        <div class="stormis-gold-divider" style="justify-content: flex-start;">
          <span>~ THE ART OF GIFTING ~</span>
        </div>
        <h2 class="stormis-gifting-dark__title">
          Unboxing an Heirloom Sweet Experience
        </h2>
        <p style="color: #6E6259; font-size: 15px; line-height: 1.7; margin: 0;">
          Every Stormi’s Godis box is handcrafted to evoke the tactile magic of receiving a luxury gift from Stockholm. From rigid keepsake boxes with gold debossed seals to silk-tied ribbons and complimentary handwritten personalized notes.
        </p>

        <div class="stormis-gifting-features">
          <div class="stormis-gift-item">
            <span>✓</span> Rigid matte keepsake gift case with gold foil debossing
          </div>
          <div class="stormis-gift-item">
            <span>✓</span> Complimentary personalized handwritten gift note
          </div>
          <div class="stormis-gift-item">
            <span>✓</span> Temperature-safe insulated packaging for perfect delivery
          </div>
        </div>

        <a href="/collections/all" class="stormis-gold-btn">
          Explore Gift Boxes
        </a>
      </div>

      <!-- Gifting Image -->
      <div class="stormis-gifting-img-wrap">
        <img src="{{ 'stormis-lifestyle-banner.jpg' | asset_url }}" alt="Stormi’s Godis Luxury Gift Box" class="stormis-gifting-img" loading="lazy" width="600" height="450">
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Stormis Light Gifting",
  "settings": [],
  "presets": [
    {
      "name": "Stormis Light Gifting"
    }
  ]
}
{% endschema %}
