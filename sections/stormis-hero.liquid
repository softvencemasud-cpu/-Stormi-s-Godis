<style>
  .stormis-hero-dark {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    background-color: #110E0D;
    background-image: linear-gradient(to right, rgba(17, 14, 13, 0.96) 0%, rgba(17, 14, 13, 0.8) 45%, rgba(17, 14, 13, 0.3) 100%), url("{{ 'stormis-hero-banner.jpg' | asset_url }}");
    background-size: cover;
    background-position: center right;
    background-repeat: no-repeat;
    padding: 100px 0;
    overflow: hidden;
  }
  @media (max-width: 991px) {
    .stormis-hero-dark {
      min-height: 75vh;
      background-image: linear-gradient(to bottom, rgba(17, 14, 13, 0.95) 0%, rgba(17, 14, 13, 0.85) 60%, rgba(17, 14, 13, 0.5) 100%), url("{{ 'stormis-hero-banner.jpg' | asset_url }}");
      background-position: center;
      padding: 70px 0;
    }
  }
  .stormis-hero-dark__container {
    width: 92% !important;
    max-width: 1440px !important;
    margin: 0 auto !important;
  }
  .stormis-hero-dark__content {
    max-width: 680px;
    position: relative;
    z-index: 2;
  }
  .stormis-hero-dark__eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #FAF7F2;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .stormis-hero-dark__eyebrow span {
    color: #E5A93C;
  }
  .stormis-hero-dark__brand {
    font-family: 'Great Vibes', cursive;
    font-size: 78px;
    line-height: 1.1;
    color: #FAF7F2;
    margin-bottom: 16px;
    display: block;
    text-shadow: 0 4px 20px rgba(0,0,0,0.5);
  }
  @media (max-width: 767px) {
    .stormis-hero-dark__brand {
      font-size: 48px;
    }
  }
  .stormis-hero-dark__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 48px;
    line-height: 1.15;
    color: #FAF7F2;
    margin-bottom: 22px;
    font-weight: 600;
  }
  @media (max-width: 767px) {
    .stormis-hero-dark__title {
      font-size: 30px;
    }
  }
  .stormis-hero-dark__title span {
    color: #E5A93C;
  }
  .stormis-hero-dark__desc {
    font-size: 16px;
    line-height: 1.7;
    color: #D5CBC0;
    margin-bottom: 40px;
  }
  @media (max-width: 767px) {
    .stormis-hero-dark__desc {
      font-size: 14px;
      margin-bottom: 28px;
    }
  }
  .stormis-hero-dark__cta-wrap {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  @media (max-width: 640px) {
    .stormis-hero-dark__cta-wrap {
      flex-direction: column;
      gap: 12px;
      width: 100%;
    }
  }
  .stormis-gold-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 38px;
    background-color: #E5A93C;
    color: #110E0D !important;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 6px 20px rgba(229, 169, 60, 0.3);
  }
  @media (max-width: 640px) {
    .stormis-gold-btn {
      width: 100%;
      box-sizing: border-box;
      text-align: center;
      padding: 14px 20px;
    }
  }
  .stormis-gold-btn:hover {
    background-color: #F4C468;
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(229, 169, 60, 0.45);
  }
  .stormis-outline-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 15px 34px;
    background: transparent;
    color: #FAF7F2 !important;
    border: 1px solid #4A3E37;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  @media (max-width: 640px) {
    .stormis-outline-btn {
      width: 100%;
      box-sizing: border-box;
      text-align: center;
      padding: 14px 20px;
    }
  }
  .stormis-outline-btn:hover {
    border-color: #E5A93C;
    color: #E5A93C !important;
    background: rgba(229, 169, 60, 0.05);
  }
</style>

<section class="stormis-hero-dark">
  <div class="stormis-hero-dark__container">
    <div class="stormis-hero-dark__content">
      <div class="stormis-hero-dark__eyebrow">
        <span>✦</span> START YOUR SWEET JOURNEY WITH OUR EXCLUSIVE COLLECTION
      </div>
      <span class="stormis-hero-dark__brand">Stormi’s Godis</span>
      <h1 class="stormis-hero-dark__title">
        Explore the Art of <span>Swedish Confectionery</span>
      </h1>
      <p class="stormis-hero-dark__desc">
        Indulge in artisanal Swedish sweets crafted from wild Nordic berries, single-origin dark chocolate, and heritage recipes made for gifting and quiet indulgence.
      </p>
      <div class="stormis-hero-dark__cta-wrap">
        <a href="/collections/all" class="stormis-gold-btn">
          Shop Collection Now
        </a>
        <a href="/pages/about-us" class="stormis-outline-btn">
          Gifting Concierge
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Stormis Dark Hero",
  "settings": [],
  "presets": [
    {
      "name": "Stormis Dark Hero"
    }
  ]
}
{% endschema %}
