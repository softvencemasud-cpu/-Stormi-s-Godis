<style>
  .stormis-concierge-dark {
    padding: 100px 0;
    background-color: #FFFFFF;
    border-top: 1px solid #E8E1D9;
    border-bottom: 1px solid #E8E1D9;
    width: 100%;
    box-sizing: border-box;
  }
  @media (max-width: 767px) {
    .stormis-concierge-dark {
      padding: 60px 0;
    }
  }
  .stormis-concierge-dark__container {
    width: 92% !important;
    max-width: 1440px !important;
    margin: 0 auto !important;
  }
  .stormis-concierge-dark__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 60px;
    align-items: center;
  }
  @media (max-width: 991px) {
    .stormis-concierge-dark__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
  .stormis-concierge-card {
    background: #FAF7F2;
    border-radius: 12px;
    padding: 40px 36px;
    border: 1px solid #E8E1D9;
    box-shadow: none !important;
  }
  @media (max-width: 767px) {
    .stormis-concierge-card {
      padding: 24px 18px;
    }
  }
  .stormis-concierge-card__title {
    font-family: 'Cormorant Garamond', serif !important;
    font-size: 34px !important;
    color: #110E0D !important;
    margin: 0 0 10px !important;
    font-weight: 600 !important;
  }
  .stormis-form-group {
    margin-bottom: 16px;
  }
  .stormis-form-label {
    display: block;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #110E0D;
    margin-bottom: 6px;
  }
  .stormis-form-input, .stormis-form-select, .stormis-form-textarea {
    width: 100%;
    background: #FFFFFF;
    border: 1px solid #E8E1D9;
    border-radius: 4px;
    padding: 12px 14px;
    color: #110E0D;
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s ease;
    box-sizing: border-box;
  }
  .stormis-form-input:focus, .stormis-form-select:focus, .stormis-form-textarea:focus {
    border-color: #C98D28;
  }
  .stormis-dessert-card {
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    position: relative;
    border: 1px solid #E8E1D9;
    box-shadow: none !important;
  }
  .stormis-dessert-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>

<section class="stormis-concierge-dark">
  <div class="stormis-concierge-dark__container">
    <div class="stormis-concierge-dark__grid">
      <!-- Concierge Form -->
      <div class="stormis-concierge-card">
        <div class="stormis-gold-divider" style="justify-content: flex-start;">
          <span>~ BESPOKE GIFTING ~</span>
        </div>
        <h2 class="stormis-concierge-card__title">
          Custom Gifting & Event Concierge
        </h2>
        <p style="color: #6E6259; font-size: 14px; margin-bottom: 24px; line-height: 1.6;">
          Planning a luxury corporate hamper, private tasting, wedding celebration, or bespoke confectionery box? Our Stockholm atelier team will curate a tailored proposal for you.
        </p>

        <form onsubmit="event.preventDefault(); alert('Tack så mycket! Your concierge inquiry has been received. Our team will contact you within 24 hours.');">
          <div class="stormis-form-group">
            <label class="stormis-form-label">Your Name</label>
            <input type="text" class="stormis-form-input" placeholder="Full name" required>
          </div>
          <div class="stormis-form-group">
            <label class="stormis-form-label">Email Address</label>
            <input type="email" class="stormis-form-input" placeholder="your.email@domain.com" required>
          </div>
          <div class="stormis-form-group">
            <label class="stormis-form-label">Occasion / Service Type</label>
            <select class="stormis-form-select">
              <option>Corporate Gifting & Hampers</option>
              <option>Wedding Favors & Table Display</option>
              <option>Private Stockholm Tasting</option>
              <option>Custom Ribbon & Gold Embossing</option>
            </select>
          </div>
          <div class="stormis-form-group">
            <label class="stormis-form-label">Message / Details</label>
            <textarea class="stormis-form-textarea" rows="3" placeholder="Tell us about your event, quantity, or gifting vision..."></textarea>
          </div>
          <button type="submit" class="stormis-gold-btn" style="width: 100%; border-radius: 4px; padding: 14px 20px;">
            Request Concierge Proposal
          </button>
        </form>
      </div>

      <!-- Plated Dessert / Atelier Display -->
      <div>
        <div class="stormis-dessert-card">
          <img src="{{ 'prod-choco-lifestyle.jpg' | asset_url }}" alt="Stormi’s Godis Plated Confectionery" class="stormis-dessert-img" loading="lazy" width="600" height="450">
        </div>
        <div style="margin-top: 24px;">
          <h3 style="font-family: 'Cormorant Garamond', serif; font-size: 26px; color: #110E0D; margin-bottom: 8px;">
            Handmade with Nordic Care
          </h3>
          <p style="color: #6E6259; font-size: 14px; line-height: 1.7; margin: 0;">
            From custom gold-stamped ribbons to bespoke ingredient pairings, every order is treated as a piece of edible art, dispatched in climate-insulated luxury boxes.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Stormis Light Concierge",
  "settings": [],
  "presets": [
    {
      "name": "Stormis Light Concierge"
    }
  ]
}
{% endschema %}
