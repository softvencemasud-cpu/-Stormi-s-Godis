<style>
  .stormis-categories-dark {
    padding: 100px 0;
    background-color: #FFFFFF;
    border-top: 1px solid #E8E1D9;
    border-bottom: 1px solid #E8E1D9;
    width: 100%;
    box-sizing: border-box;
  }
  @media (max-width: 767px) {
    .stormis-categories-dark {
      padding: 50px 0;
    }
  }
  .stormis-categories-dark__container {
    width: 92% !important;
    max-width: 1440px !important;
    margin: 0 auto !important;
  }
  .stormis-categories-dark__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 40px;
  }
  .stormis-categories-dark__title {
    font-family: 'Cormorant Garamond', serif !important;
    font-size: 42px !important;
    line-height: 1.15 !important;
    color: #110E0D !important;
    margin-bottom: 12px !important;
    font-weight: 600 !important;
  }
  @media (max-width: 767px) {
    .stormis-categories-dark__title {
      font-size: 28px !important;
    }
  }
  .stormis-categories-dark__grid {
    display: grid !important;
    grid-template-columns: repeat(4, 1fr) !important;
    gap: 24px !important;
    width: 100% !important;
  }
  @media (max-width: 991px) {
    .stormis-categories-dark__grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 16px !important;
    }
  }
  @media (max-width: 640px) {
    .stormis-categories-dark__grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 10px !important;
    }
  }

  /* Flat Clean Category Cards - NO SHADOW & NO HOVER LIFT */
  .stormis-category-dark-card {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    text-decoration: none;
    border: 1px solid #E8E1D9;
    transition: border-color 0.25s ease;
    display: block;
    width: 100%;
    box-sizing: border-box;
    box-shadow: none !important;
    transform: none !important;
  }
  .stormis-category-dark-card:hover {
    border-color: #C98D28 !important;
    box-shadow: none !important;
    transform: none !important;
  }
  .stormis-category-dark-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .stormis-category-dark-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(17, 14, 13, 0.9) 0%, rgba(17, 14, 13, 0.3) 50%, rgba(17, 14, 13, 0.05) 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 20px 16px;
    color: #FAF7F2;
  }
  @media (max-width: 640px) {
    .stormis-category-dark-card__overlay {
      padding: 12px 10px;
    }
  }
  .stormis-category-dark-card__tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #E5A93C;
    margin-bottom: 4px;
  }
  @media (max-width: 640px) {
    .stormis-category-dark-card__tag {
      font-size: 9px;
    }
  }
  .stormis-category-dark-card__name {
    font-family: 'Cormorant Garamond', serif !important;
    font-size: 24px !important;
    line-height: 1.2 !important;
    color: #FAF7F2 !important;
    margin-bottom: 6px !important;
    font-weight: 600 !important;
  }
  @media (max-width: 640px) {
    .stormis-category-dark-card__name {
      font-size: 17px !important;
      margin-bottom: 2px !important;
    }
  }
  .stormis-category-dark-card__count {
    font-size: 12px;
    color: #FAF7F2;
    display: flex;
    align-items: center;
    gap: 4px;
    transition: color 0.2s ease;
  }
  @media (max-width: 640px) {
    .stormis-category-dark-card__count {
      font-size: 10px;
    }
  }
  .stormis-category-dark-card:hover .stormis-category-dark-card__count {
    color: #E5A93C;
  }
</style>

<section class="stormis-categories-dark">
  <div class="stormis-categories-dark__container">
    <div class="stormis-categories-dark__header">
      <div class="stormis-gold-divider">
        <span>~ CURATED COLLECTIONS ~</span>
      </div>
      <h2 class="stormis-categories-dark__title">
        Discover by World of Flavour
      </h2>
      <p style="color: #6E6259; font-size: 14px;">Explore our signature confectionery collections handcrafted for every moment.</p>
    </div>

    <div class="stormis-categories-dark__grid">
      <!-- 1 -->
      <a href="/collections/all" class="stormis-category-dark-card">
        <img src="{{ 'prod-berry-lifestyle.jpg' | asset_url }}" alt="Fruity & Sour Gummy World" class="stormis-category-dark-card__img" loading="lazy" width="400" height="500">
        <div class="stormis-category-dark-card__overlay">
          <span class="stormis-category-dark-card__tag">Artisan Jellies</span>
          <h3 class="stormis-category-dark-card__name">Fruity Favourites</h3>
          <span class="stormis-category-dark-card__count">Explore Collection →</span>
        </div>
      </a>

      <!-- 2 -->
      <a href="/collections/all" class="stormis-category-dark-card">
        <img src="{{ 'prod-choco-lifestyle.jpg' | asset_url }}" alt="Chocolate & Truffle World" class="stormis-category-dark-card__img" loading="lazy" width="400" height="500">
        <div class="stormis-category-dark-card__overlay">
          <span class="stormis-category-dark-card__tag">Single-Origin</span>
          <h3 class="stormis-category-dark-card__name">Chocolate Truffles</h3>
          <span class="stormis-category-dark-card__count">Explore Collection →</span>
        </div>
      </a>

      <!-- 3 -->
      <a href="/collections/all" class="stormis-category-dark-card">
        <img src="{{ 'prod-mix-lifestyle.jpg' | asset_url }}" alt="Nordic Mix World" class="stormis-category-dark-card__img" loading="lazy" width="400" height="500">
        <div class="stormis-category-dark-card__overlay">
          <span class="stormis-category-dark-card__tag">Heritage Mix</span>
          <h3 class="stormis-category-dark-card__name">Swedish Classics</h3>
          <span class="stormis-category-dark-card__count">Explore Collection →</span>
        </div>
      </a>

      <!-- 4 -->
      <a href="/collections/all" class="stormis-category-dark-card">
        <img src="{{ 'stormis-lifestyle-banner.jpg' | asset_url }}" alt="Gift Box Collection" class="stormis-category-dark-card__img" loading="lazy" width="400" height="500">
        <div class="stormis-category-dark-card__overlay">
          <span class="stormis-category-dark-card__tag">Luxury Keepsake</span>
          <h3 class="stormis-category-dark-card__name">Gift Boxes</h3>
          <span class="stormis-category-dark-card__count">Explore Collection →</span>
        </div>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Stormis Light Categories",
  "settings": [],
  "presets": [
    {
      "name": "Stormis Light Categories"
    }
  ]
}
{% endschema %}
