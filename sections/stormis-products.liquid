          <img src="{{ 'prod-berry-lifestyle.jpg' | asset_url }}" alt="Swedish Berry Collection Lifestyle" class="stormis-card-dark__img stormis-card-dark__img--hover" loading="lazy" width="400" height="400">
        </div>
        <div class="stormis-card-dark__body">
          <div style="color: #E5A93C; font-size: 12px; margin-bottom: 4px;">★★★★★ 5.0</div>
