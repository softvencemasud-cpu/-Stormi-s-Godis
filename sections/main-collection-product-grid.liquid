{{ 'component-product-inventory.css' | asset_url | stylesheet_tag }}
{{ 'collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collection.js' | asset_url }}" defer="defer"></script>

<style>
  .m-collection-dark {
    background-color: #FAF7F2;
    color: #110E0D;
    padding: 60px 0 100px;
    min-height: 80vh;
    width: 100%;
    box-sizing: border-box;
  }
  @media (max-width: 767px) {
    .m-collection-dark {
      padding: 40px 0 60px;
    }
  }
  .m-collection-dark__container {
    width: 92% !important;
    max-width: 1440px !important;
    margin: 0 auto !important;
  }
  .m-collection-dark__header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 40px;
  }
  .m-collection-dark__title {
    font-family: 'Cormorant Garamond', serif !important;
    font-size: 48px !important;
    color: #110E0D !important;
    margin-bottom: 12px !important;
    font-weight: 600 !important;
  }
  @media (max-width: 767px) {
    .m-collection-dark__title {
      font-size: 30px !important;
    }
  }
  .m-collection-dark__desc {
    font-size: 15px;
    color: #6E6259;
    line-height: 1.6;
  }
  .m-collection-dark__grid {
    display: grid !important;
    grid-template-columns: repeat(4, 1fr) !important;
    gap: 24px !important;
    width: 100% !important;
  }
  @media (max-width: 1024px) {
    .m-collection-dark__grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 16px !important;
    }
  }
  @media (max-width: 640px) {
    .m-collection-dark__grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 10px !important;
    }
  }

  /* Flat Clean White Cards - NO SHADOW & NO HOVER LIFT */
  .stormis-coll-card {
    background: #FFFFFF;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #E8E1D9;
    transition: border-color 0.25s ease;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    box-sizing: border-box;
    width: 100%;
    text-decoration: none;
    box-shadow: none !important;
    transform: none !important;
  }
  .stormis-coll-card:hover {
    border-color: #C98D28 !important;
    box-shadow: none !important;
    transform: none !important;
  }
  .stormis-coll-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: #F4EFEA;
  }
  .stormis-coll-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.4s ease;
  }
  .stormis-coll-card__img--hover {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
  }
  .stormis-coll-card:hover .stormis-coll-card__img--main {
    opacity: 0;
  }
  .stormis-coll-card:hover .stormis-coll-card__img--hover {
    opacity: 1;
  }
  .stormis-coll-card__badge {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 3px 7px;
    background: #C98D28;
    color: #FFFFFF;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: 3px;
    z-index: 3;
  }
  .stormis-coll-card__body {
    padding: 16px 14px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    background: #FFFFFF;
  }
  @media (max-width: 640px) {
    .stormis-coll-card__body {
      padding: 12px 10px;
    }
  }
  .stormis-coll-card__name {
    font-family: 'Cormorant Garamond', serif !important;
    font-size: 20px !important;
    line-height: 1.2 !important;
    color: #110E0D !important;
    margin-bottom: 6px !important;
    font-weight: 600 !important;
  }
  @media (max-width: 640px) {
    .stormis-coll-card__name {
      font-size: 15px !important;
      min-height: 36px;
    }
  }
  .stormis-coll-card__desc {
    font-size: 12px;
    color: #6E6259;
    line-height: 1.45;
    margin-bottom: 12px;
    flex-grow: 1;
  }
  @media (max-width: 640px) {
    .stormis-coll-card__desc {
      display: none;
    }
  }
  .stormis-coll-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 10px;
    border-top: 1px solid #E8E1D9;
    margin-top: auto;
  }
  .stormis-coll-card__price {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 17px;
    font-weight: 700;
    color: #C98D28;
  }
  .stormis-coll-card__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 14px;
    background: #C98D28;
    color: #FFFFFF;
    border: none;
    border-radius: 3px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.25s ease;
    white-space: nowrap;
    box-shadow: none !important;
  }
  .stormis-coll-card__btn:hover {
    background: #B37A1D;
  }

  @media (max-width: 640px) {
    .stormis-coll-card__footer {
      flex-direction: column !important;
      align-items: stretch !important;
      gap: 6px !important;
      padding-top: 8px !important;
    }
    .stormis-coll-card__price {
      font-size: 15px !important;
      text-align: left !important;
    }
    .stormis-coll-card__btn {
      width: 100% !important;
      box-sizing: border-box !important;
      text-align: center !important;
      padding: 8px 4px !important;
      font-size: 11px !important;
      font-weight: 700 !important;
      border-radius: 4px !important;
      display: block !important;
    }
  }
</style>

<section class="m-collection-dark">
  <div class="m-collection-dark__container">
    <div class="m-collection-dark__header">
      <div class="stormis-gold-divider">
        <span>~ SWEDISH ARTISAN CONFECTIONERY ~</span>
      </div>
      <h1 class="m-collection-dark__title">
        {{ collection.title | default: 'All Artisan Confectionery' }}
      </h1>
      <p class="m-collection-dark__desc">
        Explore our complete assortment of handcrafted Swedish gummies, single-origin chocolate pralines, and deluxe keepsake hampers.
      </p>
    </div>

    {%- if collection.products.size > 0 -%}
      <div class="m-collection-dark__grid">
        {%- for product in collection.products -%}
          <a href="{{ product.url }}" class="stormis-coll-card">
            <div class="stormis-coll-card__media">
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" class="stormis-coll-card__img" loading="lazy">
            </div>
            <div class="stormis-coll-card__body">
              <div style="color: #C98D28; font-size: 12px; margin-bottom: 4px;">★★★★★ 5.0</div>
              <h3 class="stormis-coll-card__name">{{ product.title }}</h3>
              <p class="stormis-coll-card__desc">{{ product.description | strip_html | truncatewords: 15 }}</p>
              <div class="stormis-coll-card__footer">
                <span class="stormis-coll-card__price">{{ product.price | money }}</span>
                <span class="stormis-coll-card__btn">View Details</span>
              </div>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="m-collection-dark__grid">
        <!-- 1: Swedish Berry Collection -->
        <a href="/products/swedish-berry-collection" class="stormis-coll-card">
          <div class="stormis-coll-card__media">
            <span class="stormis-coll-card__badge">Bestseller</span>
            <img src="{{ 'prod-berry-main.jpg' | asset_url }}" alt="Swedish Berry Collection" class="stormis-coll-card__img stormis-coll-card__img--main" loading="lazy" width="400" height="400">
            <img src="{{ 'prod-berry-lifestyle.jpg' | asset_url }}" alt="Swedish Berry Collection" class="stormis-coll-card__img stormis-coll-card__img--hover" loading="lazy" width="400" height="400">
          </div>
          <div class="stormis-coll-card__body">
            <div style="color: #C98D28; font-size: 12px; margin-bottom: 4px;">★★★★★ 5.0</div>
            <h3 class="stormis-coll-card__name">Swedish Berry Collection</h3>
            <p class="stormis-coll-card__desc">Wild lingonberry & raspberry artisan gummies dusted with sour crystal sugar.</p>
            <div class="stormis-coll-card__footer">
              <span class="stormis-coll-card__price">$28.00</span>
              <span class="stormis-coll-card__btn">View Details</span>
            </div>
          </div>
        </a>

        <!-- 2: Nordic Chocolate Selection -->
        <a href="/products/luxury-chocolate-selection" class="stormis-coll-card">
          <div class="stormis-coll-card__media">
            <span class="stormis-coll-card__badge">Gold Reserve</span>
            <img src="{{ 'prod-choco-main.jpg' | asset_url }}" alt="Nordic Chocolate Selection" class="stormis-coll-card__img stormis-coll-card__img--main" loading="lazy" width="400" height="400">
            <img src="{{ 'prod-choco-lifestyle.jpg' | asset_url }}" alt="Nordic Chocolate Selection" class="stormis-coll-card__img stormis-coll-card__img--hover" loading="lazy" width="400" height="400">
          </div>
          <div class="stormis-coll-card__body">
            <div style="color: #C98D28; font-size: 12px; margin-bottom: 4px;">★★★★★ 5.0</div>
            <h3 class="stormis-coll-card__name">Nordic Chocolate Selection</h3>
            <p class="stormis-coll-card__desc">Single-origin dark chocolate pralines & cocoa truffles with sea salt & gold.</p>
            <div class="stormis-coll-card__footer">
              <span class="stormis-coll-card__price">$36.00</span>
              <span class="stormis-coll-card__btn">View Details</span>
            </div>
          </div>
        </a>

        <!-- 3: Scandinavian Candy Mix -->
        <a href="/products/scandinavian-candy-mix" class="stormis-coll-card">
          <div class="stormis-coll-card__media">
            <span class="stormis-coll-card__badge">Artisan Mix</span>
            <img src="{{ 'prod-mix-main.jpg' | asset_url }}" alt="Scandinavian Candy Mix" class="stormis-coll-card__img stormis-coll-card__img--main" loading="lazy" width="400" height="400">
            <img src="{{ 'prod-mix-lifestyle.jpg' | asset_url }}" alt="Scandinavian Candy Mix" class="stormis-coll-card__img stormis-coll-card__img--hover" loading="lazy" width="400" height="400">
          </div>
          <div class="stormis-coll-card__body">
            <div style="color: #C98D28; font-size: 12px; margin-bottom: 4px;">★★★★★ 4.9</div>
            <h3 class="stormis-coll-card__name">Scandinavian Candy Mix</h3>
            <p class="stormis-coll-card__desc">Sour raspberry skulls, sweet salmiak licorice diamonds, and fruit pastilles.</p>
            <div class="stormis-coll-card__footer">
              <span class="stormis-coll-card__price">$24.00</span>
              <span class="stormis-coll-card__btn">View Details</span>
            </div>
          </div>
        </a>

        <!-- 4: Premium Swedish Gift Box -->
        <a href="/products/premium-gift-candy-box" class="stormis-coll-card">
          <div class="stormis-coll-card__media">
            <span class="stormis-coll-card__badge">Grand Gift</span>
            <img src="{{ 'prod-giftbox-main.jpg' | asset_url }}" alt="Premium Swedish Gift Box" class="stormis-coll-card__img stormis-coll-card__img--main" loading="lazy" width="400" height="400">
            <img src="{{ 'stormis-lifestyle-banner.jpg' | asset_url }}" alt="Premium Swedish Gift Box" class="stormis-coll-card__img stormis-coll-card__img--hover" loading="lazy" width="400" height="400">
          </div>
          <div class="stormis-coll-card__body">
            <div style="color: #C98D28; font-size: 12px; margin-bottom: 4px;">★★★★★ 5.0</div>
            <h3 class="stormis-coll-card__name">Premium Swedish Gift Box</h3>
            <p class="stormis-coll-card__desc">Rigid keepsake gift hamper box with gold debossed emblem and full assortment.</p>
            <div class="stormis-coll-card__footer">
              <span class="stormis-coll-card__price">$65.00</span>
              <span class="stormis-coll-card__btn">View Details</span>
            </div>
          </div>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Main Collection Grid",
  "settings": []
}
{% endschema %}
