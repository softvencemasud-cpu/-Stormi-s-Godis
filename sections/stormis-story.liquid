<style>
  .stormis-about-dark {
    padding: 110px 0;
    background-color: #161210;
    border-top: 1px solid #28201B;
    border-bottom: 1px solid #28201B;
  }
  @media (max-width: 767px) {
    .stormis-about-dark {
      padding: 65px 0;
    }
  }
  .stormis-about-dark__container {
    width: 92% !important;
    max-width: 1440px !important;
    margin: 0 auto !important;
  }
  .stormis-about-dark__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 70px;
    align-items: center;
  }
  @media (max-width: 991px) {
    .stormis-about-dark__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
  .stormis-about-dark__header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
  }
  .stormis-about-dark__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 44px;
    line-height: 1.15;
    color: #FAF7F2;
    margin-bottom: 24px;
    font-weight: 600;
  }
  @media (max-width: 767px) {
    .stormis-about-dark__title {
      font-size: 32px;
    }
  }
  .stormis-about-dark__title span {
    font-family: 'Great Vibes', cursive;
    color: #E5A93C;
    font-size: 56px;
  }
  .stormis-about-dark__text {
    font-size: 16px;
    line-height: 1.8;
    color: #D5CBC0;
    margin-bottom: 22px;
  }
  .stormis-about-dark__image-wrap {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #D4AF37;
    box-shadow: 0 20px 50px rgba(0,0,0,0.6);
  }
  .stormis-about-dark__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  .stormis-about-dark__image-wrap:hover .stormis-about-dark__img {
    transform: scale(1.04);
  }
</style>

<section class="stormis-about-dark">
  <div class="stormis-about-dark__container">
    <div class="stormis-about-dark__grid">
      <div>
        <div class="stormis-gold-divider" style="justify-content: flex-start; margin-bottom: 16px;">
          <span>~ ABOUT <span class="stormis-script" style="font-size: 30px;">Stormi’s Godis</span> ~</span>
        </div>
        <h2 class="stormis-about-dark__title">
          Where Swedish Sweetness Meets <span>Artisan Passion</span>
        </h2>
        <p class="stormis-about-dark__text">
          The atelier where confectionery of your dreams is crafted in small batches. The perfect destination to satisfy your sophisticated sweet cravings and soothe your senses with the aesthetic charm of Scandinavian sweets.
        </p>
        <p class="stormis-about-dark__text">
          A place where you can experience the harmonious balance between rich dark cocoa, vibrant wild berries, and authentic salted licorice. Every treat is created to turn everyday moments into celebrations.
        </p>
        <div style="margin-top: 36px;">
          <a href="/collections/all" class="stormis-gold-btn">
            Explore Menu Now
          </a>
        </div>
      </div>

      <div class="stormis-about-dark__image-wrap">
        <img src="{{ 'stormis-brand-story.jpg' | asset_url }}" alt="Stormi's Godis Handcrafted Sweets" class="stormis-about-dark__img" loading="lazy" width="650" height="500">
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Stormis Dark About",
  "settings": [],
  "presets": [
    {
      "name": "Stormis Dark About"
    }
  ]
}
{% endschema %}
