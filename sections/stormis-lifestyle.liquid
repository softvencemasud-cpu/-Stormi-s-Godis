<style>
  .stormis-lifestyle {
    position: relative;
    padding: 140px 0;
    background-color: #1E1B18;
    background-image: linear-gradient(to right, rgba(30, 27, 24, 0.85) 0%, rgba(30, 27, 24, 0.4) 60%, rgba(30, 27, 24, 0.2) 100%), url("{{ 'stormis-lifestyle-banner.jpg' | asset_url }}");
    background-size: cover;
    background-position: center;
    background-attachment: scroll;
    color: #FAF7F2;
  }
  @media (max-width: 767px) {
    .stormis-lifestyle {
      padding: 80px 0;
      background-image: linear-gradient(to bottom, rgba(30, 27, 24, 0.88) 0%, rgba(30, 27, 24, 0.7) 100%), url("{{ 'stormis-lifestyle-banner.jpg' | asset_url }}");
    }
  }
  .stormis-lifestyle__box {
    max-width: 580px;
    background: rgba(30, 27, 24, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(213, 203, 192, 0.25);
    border-radius: 20px;
    padding: 48px;
  }
  @media (max-width: 580px) {
    .stormis-lifestyle__box {
      padding: 32px 24px;
    }
  }
  .stormis-lifestyle__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(197, 168, 128, 0.15);
    border: 1px solid rgba(197, 168, 128, 0.4);
    border-radius: 30px;
    color: #DFCAB0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .stormis-lifestyle__title {
    font-family: 'Cormorant Garamond', 'Playfair Display', Georgia, serif;
    font-size: 44px;
    line-height: 1.15;
    color: #FFFFFF;
    margin-bottom: 18px;
    font-weight: 600;
  }
  @media (max-width: 767px) {
    .stormis-lifestyle__title {
      font-size: 32px;
    }
  }
  .stormis-lifestyle__desc {
    font-size: 16px;
    line-height: 1.7;
    color: #E2DBD2;
    margin-bottom: 32px;
  }
  .stormis-lifestyle__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 36px;
    background-color: #FAF7F2;
    color: #1E1B18 !important;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.04em;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .stormis-lifestyle__btn:hover {
    background-color: #C83E3E;
    color: #FFFFFF !important;
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(200, 62, 62, 0.3);
  }
</style>

<section class="stormis-lifestyle">
  <div class="m-container container" style="max-width: 1280px; margin: 0 auto; padding: 0 20px; width: 100%;">
    <div class="stormis-lifestyle__box">
      <div class="stormis-lifestyle__badge">
        Modern Scandinavian Living
      </div>
      <h2 class="stormis-lifestyle__title">
        Sweet Moments Made Premium
      </h2>
      <p class="stormis-lifestyle__desc">
        Elevate your intimate gatherings, evening celebrations, and classic Swedish fika moments with artisan confectionery crafted for the refined palate.
      </p>
      <a href="/collections/all" class="stormis-lifestyle__btn">
        Explore Collection
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Stormis Lifestyle Banner",
  "settings": [],
  "presets": [
    {
      "name": "Stormis Lifestyle Banner"
    }
  ]
}
{% endschema %}
