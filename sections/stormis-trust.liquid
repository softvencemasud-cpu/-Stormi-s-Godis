<style>
  .stormis-trust-strip-dark {
    background-color: #161210;
    border-top: 1px solid #28201B;
    border-bottom: 1px solid #28201B;
    padding: 24px 0;
  }
  .stormis-trust-strip-dark__container {
    width: 92% !important;
    max-width: 1440px !important;
    margin: 0 auto !important;
  }
  .stormis-trust-grid-dark {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    align-items: center;
  }
  @media (max-width: 991px) {
    .stormis-trust-grid-dark {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }
  @media (max-width: 480px) {
    .stormis-trust-grid-dark {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
  .stormis-trust-item-dark {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-size: 13px;
    font-weight: 600;
    color: #FAF7F2;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .stormis-trust-icon-dark {
    width: 20px;
    height: 20px;
    color: #E5A93C;
    flex-shrink: 0;
  }
</style>

<div class="stormis-trust-strip-dark">
  <div class="stormis-trust-strip-dark__container">
    <div class="stormis-trust-grid-dark">
      <div class="stormis-trust-item-dark">
        <svg class="stormis-trust-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        <span>Small-Batch Crafted</span>
      </div>
      <div class="stormis-trust-item-dark">
        <svg class="stormis-trust-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>
        <span>Single-Origin & Pure</span>
      </div>
      <div class="stormis-trust-item-dark">
        <svg class="stormis-trust-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
        <span>Swedish Inspired</span>
      </div>
      <div class="stormis-trust-item-dark">
        <svg class="stormis-trust-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path></svg>
        <span>Luxury Gold Packaging</span>
      </div>
    </div>
  </div>
</div>

