<!-- Stormi's Godis Clean Scandinavian Luxury Fonts & Design System (White Theme) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Great+Vibes&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
  :root {
    --font-script: 'Great Vibes', cursive;
    --font-heading: 'Cormorant Garamond', 'Playfair Display', Georgia, serif;
    --font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    
    /* White / Light Luxury Palette */
    --color-bg-main: #FAF7F2;
    --color-surface-white: #FFFFFF;
    --color-surface-soft: #F4EFEA;
    --color-text-dark: #110E0D;
    --color-text-muted: #6E6259;
    --color-gold: #C98D28;
    --color-gold-hover: #B37A1D;
    --color-gold-border: #D4AF37;
    --color-border-light: #E8E1D9;
  }

  /* Global Layout & Unified Grid Alignment: w-11/12 mx-auto */
  body {
    background-color: #FAF7F2 !important;
    color: #110E0D !important;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif !important;
    overflow-x: hidden;
  }

  .m-container,
  .container,
  .container-fluid,
  .m-header__container,
  .m-announcement-bar__container,
  .stormis-hero-dark__container,
  .stormis-about-dark__container,
  .stormis-products-dark__container,
  .stormis-categories-dark__container,
  .stormis-statement-dark__container,
  .stormis-gallery-dark__container,
  .stormis-concierge-dark__container,
  .stormis-ingredients-dark__container,
  .stormis-features-dark__container,
  .stormis-reviews-dark__container,
  .stormis-sweet-club-dark__container,
  .stormis-footer-multi__container,
  .m-collection-dark__container,
  .stormis-product-page-dark__container,
  .w-11-12 {
    width: 92% !important;
    max-width: 1440px !important;
    margin-left: auto !important;
    margin-right: auto !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    box-sizing: border-box !important;
  }

  .m-header__inner {
    padding-left: 0 !important;
    padding-right: 0 !important;
  }
  .m-menu--main {
    margin-left: 0 !important;
    padding-left: 0 !important;
  }
  .m-menu__item:first-child .m-menu__item-link {
    padding-left: 0 !important;
  }

  h1, h2, h3, h4, .m-heading, .m-font-heading, .m-hero__title, .m-section__heading, .m-richtext__title {
    font-family: 'Cormorant Garamond', 'Playfair Display', Georgia, serif !important;
    color: #110E0D !important;
    font-weight: 600;
  }

  /* Script Font & Flourishes */
  .stormis-script {
    font-family: 'Great Vibes', cursive !important;
    font-weight: 400 !important;
    color: #C98D28 !important;
    letter-spacing: 0.02em !important;
  }

  .stormis-gold-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: #C98D28;
    font-size: 17px;
    margin-bottom: 12px;
    letter-spacing: 0.1em;
  }
  .stormis-gold-divider::before, .stormis-gold-divider::after {
    content: '';
    display: inline-block;
    width: 32px;
    height: 1px;
    background: linear-gradient(to right, transparent, #C98D28);
  }
  .stormis-gold-divider::after {
    background: linear-gradient(to left, transparent, #C98D28);
  }

  /* Transparent on Top & Sticky on Scroll Header */
  .m-header.transparent-on-top:not(.m-header--sticky) {
    background-color: transparent !important;
    border-bottom: 1px solid rgba(17, 14, 13, 0.08) !important;
  }
  .m-header--sticky,
  .m-header:not(.transparent-on-top) {
    background-color: rgba(255, 255, 255, 0.96) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    border-bottom: 1px solid #E8E1D9 !important;
  }

  .m-header__logo-text {
    font-family: 'Cormorant Garamond', serif !important;
    font-size: 32px !important;
    font-weight: 700 !important;
    letter-spacing: 0.06em !important;
    color: #110E0D !important;
  }
  .m-header__logo-text::after {
    content: ' Godis';
    font-family: 'Great Vibes', cursive !important;
    color: #C98D28 !important;
    font-size: 36px !important;
    font-weight: 400 !important;
  }

  .m-announcement-bar {
    background-color: #F4EFEA !important;
    color: #110E0D !important;
    border-bottom: 1px solid #E8E1D9 !important;
    font-size: 13px !important;
    font-weight: 600 !important;
    letter-spacing: 0.06em !important;
  }
  .m-menu__item-link {
    font-size: 13px !important;
    font-weight: 600 !important;
    letter-spacing: 0.08em !important;
    color: #110E0D !important;
    text-transform: uppercase !important;
  }
  .m-menu__item-link:hover {
    color: #C98D28 !important;
  }

  /* NO HOVER LIFT & NO SHADOW ON ANY CARDS (User Explicit Requirement) */
  .stormis-card-dark,
  .stormis-coll-card,
  .stormis-category-dark-card,
  .stormis-framed-card,
  .stormis-feat-dark-card,
  .stormis-review-dark-card,
  .m-product-item,
  .m-card,
  .m-product-card {
    box-shadow: none !important;
    transform: none !important;
    transition: border-color 0.25s ease !important;
  }
  .stormis-card-dark:hover,
  .stormis-coll-card:hover,
  .stormis-category-dark-card:hover,
  .stormis-framed-card:hover,
  .stormis-feat-dark-card:hover,
  .stormis-review-dark-card:hover,
  .m-product-item:hover,
  .m-card:hover,
  .m-product-card:hover {
    box-shadow: none !important;
    transform: none !important;
    border-color: #C98D28 !important;
  }

  /* Gold Buttons */
  .m-button--primary:not(.m-button--scroll-top):not(#scroll-to-top-button),
  .sf__btn-primary:not(.m-button--scroll-top):not(#scroll-to-top-button),
  .stormis-gold-btn {
    background-color: #C98D28 !important;
    color: #FFFFFF !important;
    border-radius: 4px !important;
    border: none !important;
    padding: 15px 36px !important;
    font-size: 13px !important;
    font-weight: 700 !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
    transition: background-color 0.25s ease !important;
    box-shadow: none !important;
  }
  .m-button--primary:not(.m-button--scroll-top):not(#scroll-to-top-button):hover,
  .sf__btn-primary:not(.m-button--scroll-top):not(#scroll-to-top-button):hover,
  .stormis-gold-btn:hover {
    background-color: #B37A1D !important;
    color: #FFFFFF !important;
    transform: none !important;
    box-shadow: none !important;
  }

  /* Scroll-to-Top Button */
  #scroll-to-top-button,
  .m-button--scroll-top {
    width: 48px !important;
    height: 48px !important;
    min-width: 48px !important;
    min-height: 48px !important;
    max-width: 48px !important;
    max-height: 48px !important;
    border-radius: 50% !important;
    padding: 0 !important;
    background-color: #C98D28 !important;
    color: #FFFFFF !important;
    border: 1px solid #D4AF37 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-shadow: none !important;
  }
  #scroll-to-top-button:hover,
  .m-button--scroll-top:hover {
    background-color: #B37A1D !important;
    transform: none !important;
    box-shadow: none !important;
  }
  #scroll-to-top-button svg,
  .m-button--scroll-top svg {
    width: 18px !important;
    height: 18px !important;
    fill: none !important;
    stroke: #FFFFFF !important;
    color: #FFFFFF !important;
    stroke-width: 2.5px !important;
    display: block !important;
    margin: 0 !important;
  }

  /* Template pages */
  .template-product, .template-collection, .template-page {
    background-color: #FAF7F2 !important;
  }
</style>