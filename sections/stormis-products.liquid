          <img src="{{ 'prod-choco-lifestyle.jpg' | asset_url }}" alt="Nordic Chocolate Selection Lifestyle" class="stormis-card-dark__img stormis-card-dark__img--hover" loading="lazy" width="400" height="400">
        </div>
        <div class="stormis-card-dark__body">
