<style>
  .stormis-statement-dark {
    padding: 80px 0;
    background-color: #F4EFEA;
    border-top: 1px solid #E8E1D9;
    border-bottom: 1px solid #E8E1D9;
    text-align: center;
    width: 100%;
    box-sizing: border-box;
  }
  .stormis-statement-dark__container {
    width: 92% !important;
    max-width: 920px !important;
    margin: 0 auto !important;
  }
  .stormis-statement-dark__quote {
    font-family: 'Cormorant Garamond', serif !important;
    font-size: 38px !important;
    line-height: 1.3 !important;
    color: #110E0D !important;
    font-weight: 500 !important;
    margin-bottom: 16px !important;
  }
  @media (max-width: 767px) {
    .stormis-statement-dark__quote {
      font-size: 26px !important;
    }
  }
  .stormis-statement-dark__sub {
    font-size: 14px;
    color: #6E6259;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
  }
</style>

<section class="stormis-statement-dark">
  <div class="stormis-statement-dark__container">
    <div class="stormis-gold-divider">
      <span>~ THE ART OF INDULGENCE ~</span>
    </div>
    <blockquote class="stormis-statement-dark__quote">
      “Confectionery crafted not for haste, but for the sacred quiet joy of the Swedish <span class="stormis-script" style="font-size: 42px;">Fika</span>.”
    </blockquote>
    <div class="stormis-statement-dark__sub">
      Stockholm • Handmade in Small Batches • Pure Nordic Botanicals
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Stormis Light Statement",
  "settings": [],
  "presets": [
    {
      "name": "Stormis Light Statement"
    }
  ]
}
{% endschema %}
