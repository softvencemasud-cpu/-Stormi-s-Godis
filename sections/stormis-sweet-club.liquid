<style>
  .stormis-newsletter-dark {
    padding: 100px 0;
    background-color: #FFFFFF;
    border-top: 1px solid #E8E1D9;
    text-align: center;
    width: 100%;
    box-sizing: border-box;
  }
  @media (max-width: 767px) {
    .stormis-newsletter-dark {
      padding: 60px 0;
    }
  }
  .stormis-newsletter-dark__container {
    width: 92% !important;
    max-width: 650px !important;
    margin: 0 auto !important;
  }
  .stormis-newsletter-dark__title {
    font-family: 'Cormorant Garamond', serif !important;
    font-size: 42px !important;
    line-height: 1.15 !important;
    color: #110E0D !important;
    margin-bottom: 12px !important;
    font-weight: 600 !important;
  }
  @media (max-width: 767px) {
    .stormis-newsletter-dark__title {
      font-size: 28px !important;
    }
  }
  .stormis-newsletter-dark__desc {
    font-size: 15px;
    color: #6E6259;
    line-height: 1.6;
    margin-bottom: 30px;
  }
  .stormis-newsletter-dark__form {
    display: flex;
    max-width: 500px;
    margin: 0 auto;
    background: #FFFFFF;
    border: 1px solid #E8E1D9;
    border-radius: 4px;
    overflow: hidden;
    box-shadow: none !important;
  }
  @media (max-width: 580px) {
    .stormis-newsletter-dark__form {
      flex-direction: column;
      border: none;
      background: transparent;
      gap: 10px;
    }
  }
  .stormis-newsletter-dark__input {
    flex-grow: 1;
    background: transparent;
    border: none;
    padding: 16px 20px;
    color: #110E0D;
    font-size: 14px;
    outline: none;
  }
  @media (max-width: 580px) {
    .stormis-newsletter-dark__input {
      background: #FFFFFF;
      border: 1px solid #E8E1D9;
      border-radius: 4px;
    }
  }
  .stormis-newsletter-dark__btn {
    background: #C98D28;
    color: #FFFFFF;
    border: none;
    padding: 16px 28px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.25s ease;
    box-shadow: none !important;
  }
  .stormis-newsletter-dark__btn:hover {
    background: #B37A1D;
  }
</style>

<section class="stormis-newsletter-dark">
  <div class="stormis-newsletter-dark__container">
    <div class="stormis-gold-divider">
      <span>~ JOIN THE SWEET CLUB ~</span>
    </div>
    <h2 class="stormis-newsletter-dark__title">
      Unlock Secret Drops & 10% Off
    </h2>
    <p class="stormis-newsletter-dark__desc">
      Subscribe to receive exclusive access to small-batch seasonal releases, private tasting invitations, and 10% off your first order.
    </p>

    <form class="stormis-newsletter-dark__form" onsubmit="event.preventDefault(); alert('Tack så mycket! You have joined The Sweet Club. Check your email for your 10% welcome code.');">
      <input type="email" class="stormis-newsletter-dark__input" placeholder="Enter your email address..." required>
      <button type="submit" class="stormis-newsletter-dark__btn">
        Join The Club
      </button>
    </form>
  </div>
</section>

{% schema %}
{
  "name": "Stormis Light Sweet Club",
  "settings": [],
  "presets": [
    {
      "name": "Stormis Light Sweet Club"
    }
  ]
}
{% endschema %}
